#!/bin/bash
# loupe-view: shows images over the whole terminal with the kitty graphics protocol,
# with zoom and pan. Written for herdr on macOS; needs only sips, base64 and stty.
#
#   loupe-view <n> <file> [file ...]   open on the n-th file (counting from 1)
#   loupe-view --self-test             check the fit and crop math against hooks/layout.ts
#
# Keys: h/l prev/next, i/o zoom in/out, z 2x at the centre, 0 fit, w/a/s/d pan, q or Esc quit.
# Mouse: the wheel zooms about the pointer, a left drag pans, a double-click toggles 2x there,
# a click on the left or right tenth steps through the images, and the status bar has buttons.
# A zoom is a crop made with sips into $TMPDIR/claude-loupe/view/, the same crop the
# in-Claude viewer makes (hooks/layout.ts): the box's shape at level times the fit scale.

set -u

LEVELS="1 2 3 4 6 8"
# A cell's width and height: real pixels when the terminal answers CSI 16 t, else 1:2.
CW=1
CH=2

# --- math (integers; centres are kept doubled so a half pixel stays exact) ---------

# R = round(a / b) for a >= 0, b > 0, halves up like Math.round.
rdiv() { R=$(((2 * $1 + $2) / (2 * $2))); }

# clamp n lo hi -> R
clamp() {
	R=$1
	((R < $2)) && R=$2
	((R > $3)) && R=$3
	:
}

# fit_cells w h maxcols maxrows -> FIT_C FIT_R: the largest box of cells that keeps the shape.
fit_cells() {
	local w=$1 h=$2 maxc=$3 maxr=$4 c r
	((maxc < 1)) && maxc=1
	((maxr < 1)) && maxr=1
	r=$maxr
	rdiv $((r * w * CH)) $((h * CW))
	c=$R
	if ((c > maxc)); then
		c=$maxc
		rdiv $((c * h * CW)) $((w * CH))
		r=$R
	fi
	clamp "$c" 1 "$maxc"
	FIT_C=$R
	clamp "$r" 1 "$maxr"
	FIT_R=$R
}

# crop_at w h boxcols boxrows level cx2 cy2 -> CROP_X CROP_Y CROP_W CROP_H
crop_at() {
	local w=$1 h=$2 bw=$(($3 * CW)) bh=$(($4 * CH)) level=$5 cx2=$6 cy2=$7 cw ch n
	((bw < CW)) && bw=$CW
	((bh < CH)) && bh=$CH
	if ((bw * h <= bh * w)); then
		rdiv "$w" "$level"
		cw=$R
		rdiv $((bh * w)) $((bw * level))
		ch=$R
	else
		rdiv $((bw * h)) $((bh * level))
		cw=$R
		rdiv "$h" "$level"
		ch=$R
	fi
	clamp "$cw" 1 "$w"
	CROP_W=$R
	clamp "$ch" 1 "$h"
	CROP_H=$R
	# round(cx - width / 2), kept inside the image
	n=$((cx2 - CROP_W + 1))
	((n < 0)) && n=0
	clamp $((n / 2)) 0 $((w - CROP_W))
	CROP_X=$R
	n=$((cy2 - CROP_H + 1))
	((n < 0)) && n=0
	clamp $((n / 2)) 0 $((h - CROP_H))
	CROP_Y=$R
}

# max_zoom w h boxcols boxrows -> MAXZ: the deepest level with a pixel per cell across and down.
max_zoom() {
	local w=$1 h=$2 c=$3 r=$4 l mw mh
	mw=$((w < c ? w : c))
	mh=$((h < r ? h : r))
	MAXZ=1
	for l in $LEVELS; do
		crop_at "$w" "$h" "$c" "$r" "$l" "$w" "$h"
		((CROP_W < mw || CROP_H < mh)) && break
		MAXZ=$l
	done
}

# next_view w h boxcols boxrows key, over LEVEL CX2 CY2 (key: in out fit toggle up down left right).
next_view() {
	local w=$1 h=$2 c=$3 r=$4 key=$5 lv=1 l cap dx=0 dy=0
	max_zoom "$w" "$h" "$c" "$r"
	cap=$((LEVEL < MAXZ ? LEVEL : MAXZ))
	for l in $LEVELS; do ((l <= cap)) && lv=$l; done
	case $key in
	fit)
		LEVEL=1 CX2=$w CY2=$h
		return
		;;
	toggle)
		if ((lv > 1)); then
			LEVEL=1 CX2=$w CY2=$h
		elif ((MAXZ >= 2)); then
			LEVEL=2 CX2=$w CY2=$h
		fi
		return
		;;
	in)
		LEVEL=$lv
		for l in $LEVELS; do
			if ((l > lv && l <= MAXZ)); then
				LEVEL=$l
				break
			fi
		done
		return
		;;
	out)
		LEVEL=1
		for l in $LEVELS; do ((l < lv)) && LEVEL=$l; done
		return
		;;
	left) dx=-1 ;;
	right) dx=1 ;;
	up) dy=-1 ;;
	down) dy=1 ;;
	esac
	((lv <= 1)) && return
	crop_at "$w" "$h" "$c" "$r" "$lv" "$CX2" "$CY2"
	crop_at "$w" "$h" "$c" "$r" "$lv" $((2 * CROP_X + CROP_W + dx * CROP_W)) $((2 * CROP_Y + CROP_H + dy * CROP_H))
	LEVEL=$lv
	CX2=$((2 * CROP_X + CROP_W))
	CY2=$((2 * CROP_Y + CROP_H))
}

# R = floor(a / b) for any a, b > 0 (bash's / cuts toward zero).
fdiv() {
	if (($1 >= 0)); then
		R=$(($1 / $2))
	else
		R=$((-((-$1 + $2 - 1) / $2)))
	fi
}

# view_geom w h boxcols boxrows, over LEVEL CX2 CY2 -> LV MAXZ, the pixels shown (VIEW_X VIEW_Y
# VIEW_W VIEW_H), and the cells they are drawn in (from IMG_C, IMG_R, FIT_C by FIT_R), as draw has them.
view_geom() {
	local w=$1 h=$2 c=$3 r=$4 l
	max_zoom "$w" "$h" "$c" "$r"
	LV=1
	for l in $LEVELS; do ((l <= LEVEL && l <= MAXZ)) && LV=$l; done
	VIEW_X=0 VIEW_Y=0 VIEW_W=$w VIEW_H=$h
	if ((LV > 1)); then
		crop_at "$w" "$h" "$c" "$r" "$LV" "$CX2" "$CY2"
		VIEW_X=$CROP_X VIEW_Y=$CROP_Y VIEW_W=$CROP_W VIEW_H=$CROP_H
	fi
	fit_cells "$VIEW_W" "$VIEW_H" "$c" "$r"
	IMG_C=$(((c - FIT_C) / 2 + 1))
	IMG_R=$(((r - FIT_R) / 2 + 1))
}

# zoom_at w h boxcols boxrows key col row, over LEVEL CX2 CY2 (key: in out toggle): zooms like the
# keys, but keeps the image point under the cell col,row (counting from 1) on that cell.
zoom_at() {
	local w=$1 h=$2 c=$3 r=$4 key=$5 col=$6 row=$7 old=$LEVEL lv vx vy vw vh fc fr ic ir nl a b
	view_geom "$w" "$h" "$c" "$r"
	lv=$LV vx=$VIEW_X vy=$VIEW_Y vw=$VIEW_W vh=$VIEW_H fc=$FIT_C fr=$FIT_R ic=$IMG_C ir=$IMG_R
	next_view "$w" "$h" "$c" "$r" "$key"
	nl=$LEVEL
	if ((nl == lv || nl > MAXZ)); then
		LEVEL=$old
		return
	fi
	if ((nl <= 1)); then
		LEVEL=1 CX2=$w CY2=$h
		return
	fi
	# The new crop's size and cells, then its corner: the point less the pointer's share of the crop.
	crop_at "$w" "$h" "$c" "$r" "$nl" "$w" "$h"
	fit_cells "$CROP_W" "$CROP_H" "$c" "$r"
	clamp "$col" "$ic" $((ic + fc - 1))
	a=$((2 * (R - ic) + 1))
	clamp "$col" $(((c - FIT_C) / 2 + 1)) $(((c - FIT_C) / 2 + FIT_C))
	b=$((2 * (R - (c - FIT_C) / 2 - 1) + 1))
	fdiv $((2 * vx * fc * FIT_C + a * vw * FIT_C - b * CROP_W * fc + fc * FIT_C)) $((2 * fc * FIT_C))
	CX2=$((2 * R + CROP_W))
	clamp "$row" "$ir" $((ir + fr - 1))
	a=$((2 * (R - ir) + 1))
	clamp "$row" $(((r - FIT_R) / 2 + 1)) $(((r - FIT_R) / 2 + FIT_R))
	b=$((2 * (R - (r - FIT_R) / 2 - 1) + 1))
	fdiv $((2 * vy * fr * FIT_R + a * vh * FIT_R - b * CROP_H * fr + fr * FIT_R)) $((2 * fr * FIT_R))
	CY2=$((2 * R + CROP_H))
	crop_at "$w" "$h" "$c" "$r" "$nl" "$CX2" "$CY2"
	LEVEL=$nl
	CX2=$((2 * CROP_X + CROP_W))
	CY2=$((2 * CROP_Y + CROP_H))
}

# drag_view w h boxcols boxrows dcols drows, over LEVEL CX2 CY2: moves the view so the image
# follows a drag of dcols by drows cells (at fit there is nothing to move).
drag_view() {
	local w=$1 h=$2 c=$3 r=$4 dc=$5 dr=$6 x
	view_geom "$w" "$h" "$c" "$r"
	((LV <= 1)) && return
	fdiv $((2 * (VIEW_X * FIT_C - dc * VIEW_W) + FIT_C)) $((2 * FIT_C))
	x=$R
	fdiv $((2 * (VIEW_Y * FIT_R - dr * VIEW_H) + FIT_R)) $((2 * FIT_R))
	crop_at "$w" "$h" "$c" "$r" "$LV" $((2 * x + VIEW_W)) $((2 * R + VIEW_H))
	LEVEL=$LV
	CX2=$((2 * CROP_X + CROP_W))
	CY2=$((2 * CROP_Y + CROP_H))
}

# The status bar starts with these buttons, each drawn as [label] and a space: name:label width in columns.
BTN_LIST="prev:1 next:1 out:1 in:1 fit:3 quit:1"
BTN_BAR="[‹] [›] [−] [+] [fit] [✕]"

# button_at col -> BTN: the button under column col of the status bar, or empty.
button_at() {
	local col=$1 x=1 b w
	BTN=''
	for b in $BTN_LIST; do
		w=${b#*:}
		if ((col >= x && col <= x + w + 1)); then
			BTN=${b%:*}
			return
		fi
		x=$((x + w + 3))
	done
}

# edge_at col boxcols -> EDGE: prev or next on the left or right tenth of the box, else empty.
edge_at() {
	local col=$1 c=$2 e=$(($2 / 10))
	((e < 1)) && e=1
	EDGE=''
	((col <= e)) && EDGE=prev
	((col > c - e)) && EDGE=next
	:
}

# double_click t1 col1 row1 t2 col2 row2 (milliseconds; t1 0 is no first click): true for two
# presses within 400ms on the same cell, give or take one.
double_click() {
	(($1 > 0 && $4 - $1 <= 400 && $5 - $2 <= 1 && $2 - $5 <= 1 && $6 - $3 <= 1 && $3 - $6 <= 1))
}

self_test() {
	local fails=0
	check() {
		if [[ "$2" == "$3" ]]; then
			return
		fi
		echo "FAIL $1: want '$3' got '$2'"
		fails=$((fails + 1))
	}
	CW=1 CH=2
	while read -r w h c r want; do
		fit_cells "$w" "$h" "$c" "$r"
		check "fit $w $h $c $r" "${FIT_C-} ${FIT_R-}" "$want"
	done <<'EOF'
1600 1000 78 25 78 24
640 480 200 50 133 50
100 100 80 30 60 30
2600 400 120 40 120 9
300 3000 200 60 12 60
EOF
	while read -r w h c r l cx2 cy2 x y cw ch; do
		crop_at "$w" "$h" "$c" "$r" "$l" "$cx2" "$cy2"
		check "crop $w $h $c $r $l $cx2 $cy2" "${CROP_X-} ${CROP_Y-} ${CROP_W-} ${CROP_H-}" "$x $y $cw $ch"
	done <<'EOF'
1600 1000 78 25 2 1600 1000 400 244 800 513
1600 1000 78 25 3 200 200 0 0 533 342
640 480 200 50 4 1200 800 400 340 240 120
2600 400 120 40 2 2600 400 650 0 1300 400
1601 999 90 30 6 0 1998 0 821 267 178
EOF
	while read -r w h c r want; do
		max_zoom "$w" "$h" "$c" "$r"
		check "max $w $h $c $r" "$MAXZ" "$want"
	done <<'EOF'
100 100 78 25 2
1600 1000 78 25 8
640 480 200 50 4
3000 2000 150 45 8
EOF
	LEVEL=1 CX2=1600 CY2=1000
	while read -r key want; do
		next_view 1600 1000 78 25 "$key"
		check "view $key" "$LEVEL $CX2 $CY2" "$want"
	done <<'EOF'
in 2 1600 1000
right 2 2400 1001
right 2 2400 1001
right 2 2400 1001
down 2 2400 1487
in 3 2400 1487
left 3 1869 1488
out 2 1869 1488
up 2 1870 975
toggle 1 1600 1000
toggle 2 1600 1000
fit 1 1600 1000
right 1 1600 1000
EOF
	# zoom about the pointer: the level, centre and pointer cell before, then the new view
	while read -r l cx2 cy2 key col row want; do
		LEVEL=$l CX2=$cx2 CY2=$cy2
		zoom_at 1600 1000 78 25 "$key" "$col" "$row"
		check "zoom_at $l $cx2 $cy2 $key $col $row" "$LEVEL $CX2 $CY2" "$want"
	done <<'EOF'
1 1600 1000 in 1 1 2 810 535
1 1600 1000 in 40 13 2 1610 1041
1 1600 1000 in 70 20 2 2226 1337
2 1600 1000 in 70 20 3 1809 1096
2 1600 1000 out 70 20 1 1600 1000
2 812 514 out 1 1 1 1600 1000
1 1600 1000 toggle 20 6 2 1200 745
2 2400 1487 toggle 20 6 1 1600 1000
8 1600 1000 in 10 10 8 1600 1000
1 1600 1000 out 10 10 1 1600 1000
1 1600 1000 in 100 30 2 2390 1465
EOF
	LEVEL=1 CX2=100 CY2=100
	zoom_at 100 100 78 25 in 40 12
	check "zoom_at small" "$LEVEL $CX2 $CY2" "2 102 96"
	# drag by cells: the image follows the pointer
	while read -r l cx2 cy2 dc dr want; do
		LEVEL=$l CX2=$cx2 CY2=$cy2
		drag_view 1600 1000 78 25 "$dc" "$dr"
		check "drag $l $cx2 $cy2 $dc $dr" "$LEVEL $CX2 $CY2" "$want"
	done <<'EOF'
2 1600 1000 10 0 2 1394 1001
2 1600 1000 -10 -4 2 1806 1165
2 1600 1000 100 0 2 800 1001
2 1600 1000 0 -30 2 1600 1487
1 1600 1000 10 5 1 1600 1000
4 1600 1000 3 2 4 1570 960
EOF
	# the status bar buttons: [‹] [›] [−] [+] [fit] [✕]
	while read -r col want; do
		button_at "$col"
		check "button $col" "${BTN:--}" "$want"
	done <<'EOF'
0 -
1 prev
3 prev
4 -
5 next
7 next
9 out
11 out
13 in
15 in
16 -
17 fit
21 fit
22 -
23 quit
25 quit
26 -
60 -
EOF
	while read -r col cols want; do
		edge_at "$col" "$cols"
		check "edge $col $cols" "${EDGE:--}" "$want"
	done <<'EOF'
1 78 prev
7 78 prev
8 78 -
40 78 -
71 78 -
72 78 next
78 78 next
1 5 prev
3 5 -
5 5 next
EOF
	while read -r t1 c1 r1 t2 c2 r2 want; do
		want_double=no
		double_click "$t1" "$c1" "$r1" "$t2" "$c2" "$r2" && want_double=yes
		check "double $t1 $c1 $r1 $t2 $c2 $r2" "$want_double" "$want"
	done <<'EOF'
1000 10 5 1300 11 5 yes
1000 10 5 1400 10 4 yes
1000 10 5 1401 10 5 no
1000 10 5 1100 12 5 no
1000 10 5 1100 10 7 no
0 10 5 100 10 5 no
EOF
	if ((fails > 0)); then
		echo "self-test: $fails failed"
		return 1
	fi
	echo "self-test: ok"
}

if [[ "${1-}" == "--self-test" ]]; then
	self_test
	exit
fi

# --- the viewer ---------------------------------------------------------------------

usage() {
	echo "usage: loupe-view <n> <file> [file ...]   (n counts from 1)" >&2
	echo "       loupe-view --self-test" >&2
	exit 2
}

(($# >= 2)) || usage
[[ $1 =~ ^[0-9]+$ ]] || usage
INDEX=$(($1 - 1))
shift
FILES=()
for f in "$@"; do
	[[ $f == /* ]] || f="$PWD/$f"
	FILES+=("$f")
done
COUNT=${#FILES[@]}
clamp "$INDEX" 0 $((COUNT - 1))
INDEX=$R

CACHE="${TMPDIR:-/tmp}"
CACHE="${CACHE%/}/claude-loupe/view"
mkdir -p "$CACHE" 2>/dev/null

# Fractional read timeouts need bash 4; macOS's /bin/bash 3.2 waits whole seconds.
if ((BASH_VERSINFO[0] >= 4)); then SHORT=0.05 TICK=0.5; else SHORT=1 TICK=1; fi

# Per image, loaded on first view: its png, width, height, or why it can't be shown.
PNG=() IMG_W=() IMG_H=() ERR=()

# KEY = a short cache name for the text in $1.
cache_key() {
	local sum _
	read -r sum _ < <(printf '%s' "$1" | cksum)
	KEY=$sum
}

load() {
	local i=$1 f=${FILES[$1]} line fmt='' w='' h='' mtime
	[[ -n "${IMG_W[$i]-}${ERR[$i]-}" ]] && return
	if [[ ! -f $f ]]; then
		ERR[i]="file not found"
		return
	fi
	while read -r line; do
		case $line in
		format:*) fmt=${line#format: } ;;
		pixelWidth:*) w=${line#pixelWidth: } ;;
		pixelHeight:*) h=${line#pixelHeight: } ;;
		esac
	done < <(sips -g format -g pixelWidth -g pixelHeight "$f" 2>/dev/null)
	if [[ ! $w =~ ^[0-9]+$ || ! $h =~ ^[0-9]+$ || $w -eq 0 || $h -eq 0 ]]; then
		ERR[i]="not an image sips can read"
		return
	fi
	PNG[i]=$f
	if [[ $fmt != png ]]; then
		mtime=$(stat -f %m "$f" 2>/dev/null)
		cache_key "conv|$f|$mtime"
		PNG[i]="$CACHE/conv-$KEY.png"
		if [[ ! -s ${PNG[$i]} ]] && ! sips -s format png "$f" --out "${PNG[$i]}" >/dev/null 2>&1; then
			ERR[i]="conversion failed"
			return
		fi
	fi
	IMG_W[i]=$w
	IMG_H[i]=$h
}

reset_view() {
	load "$INDEX"
	LEVEL=1
	CX2=${IMG_W[$INDEX]-0}
	CY2=${IMG_H[$INDEX]-0}
}

# Asks the terminal for its cell size in pixels (CSI 16 t -> CSI 6 ; h ; w t); keeps 1:2 without an answer.
cell_size() {
	local h w
	printf '\e[16t' >/dev/tty
	IFS=";" read -rs -d t -t "$SHORT" _ h w </dev/tty || return
	[[ $h =~ ^[0-9]+$ && $w =~ ^[0-9]+$ ]] && ((h > 0 && w > 0)) && CH=$h CW=$w
}

# TERM_ROWS TERM_COLS = the terminal's size, asked of the tty itself (a $(tput cols) has a pipe for stdout).
term_size() {
	TERM_ROWS=24 TERM_COLS=80
	read -r TERM_ROWS TERM_COLS < <(stty size </dev/tty 2>/dev/null)
	[[ $TERM_ROWS =~ ^[0-9]+$ && $TERM_COLS =~ ^[0-9]+$ ]] || TERM_ROWS=24 TERM_COLS=80
}

box() {
	term_size
	COLS=$TERM_COLS
	ROWS=$TERM_ROWS
	BOXC=$COLS
	BOXR=$((ROWS - 1))
	((BOXR < 1)) && BOXR=1
}

draw() {
	local w h shown sw sh lv l mtime status hint name
	box
	load "$INDEX"
	# The previous image goes first, then the screen.
	printf '\e_Ga=d,d=A,q=2\e\\\e[2J'
	name=${FILES[$INDEX]##*/}
	lv=1
	if [[ -n ${ERR[$INDEX]-} ]]; then
		status="[${ERR[$INDEX]}]"
		printf '\e[%d;%dH%s' $((BOXR / 2 + 1)) 1 "$status"
	else
		w=${IMG_W[$INDEX]} h=${IMG_H[$INDEX]}
		max_zoom "$w" "$h" "$BOXC" "$BOXR"
		for l in $LEVELS; do ((l <= LEVEL && l <= MAXZ)) && lv=$l; done
		shown=${PNG[$INDEX]} sw=$w sh=$h
		if ((lv > 1)); then
			crop_at "$w" "$h" "$BOXC" "$BOXR" "$lv" "$CX2" "$CY2"
			mtime=$(stat -f %m "$shown" 2>/dev/null)
			cache_key "crop|$shown|$mtime|$CROP_X,$CROP_Y,$CROP_W,$CROP_H"
			if [[ -s "$CACHE/crop-$KEY.png" ]] || sips -c "$CROP_H" "$CROP_W" --cropOffset "$CROP_Y" "$CROP_X" "$shown" --out "$CACHE/crop-$KEY.png" >/dev/null 2>&1; then
				shown="$CACHE/crop-$KEY.png" sw=$CROP_W sh=$CROP_H
			else
				lv=1
			fi
		fi
		fit_cells "$sw" "$sh" "$BOXC" "$BOXR"
		printf '\e[%d;%dH' $(((BOXR - FIT_R) / 2 + 1)) $(((BOXC - FIT_C) / 2 + 1))
		printf '\e_Ga=T,f=100,t=f,c=%d,r=%d,C=1,q=2;%s\e\\' "$FIT_C" "$FIT_R" "$(printf '%s' "$shown" | base64 | tr -d '\n')"
	fi
	status="$BTN_BAR  $((INDEX + 1))/$COUNT · ${lv}× · $name"
	hint="   h/l prev/next  i/o zoom  wasd pan  0 fit  z 2×  q quit"
	((${#status} + ${#hint} > COLS)) && hint="   h/l i/o wasd 0 z q"
	((${#status} + ${#hint} > COLS)) && hint=''
	status="${status}${hint}"
	printf '\e[%d;1H\e[2K\e[7m%s\e[0m' "$ROWS" "${status:0:COLS}"
}

SAVED=$(stty -g </dev/tty)
cleanup() {
	printf '\e[?1006l\e[?1002l\e[?1000l\e_Ga=d,d=A,q=2\e\\\e[0m\e[?25h\e[?1049l' >/dev/tty
	stty "$SAVED" </dev/tty
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
RESIZED=0
trap 'RESIZED=1' WINCH

# SGR mouse reports: presses, releases, motion while a button is down, and the wheel.
printf '\e[?1049h\e[?25l\e[?1000h\e[?1002h\e[?1006h' >/dev/tty
stty -echo -icanon min 1 time 0 </dev/tty
cell_size
reset_view
draw

view_key() {
	[[ -n ${IMG_W[$INDEX]-} ]] || return
	next_view "${IMG_W[$INDEX]}" "${IMG_H[$INDEX]}" "$BOXC" "$BOXR" "$1"
	draw
}

# on_key key: what a key does, and the button or click that stands for it; q sets QUIT.
on_key() {
	local n=$INDEX
	case $1 in
	h | l)
		[[ $1 == h ]] && ((INDEX > 0)) && INDEX=$((INDEX - 1))
		[[ $1 == l ]] && ((INDEX < COUNT - 1)) && INDEX=$((INDEX + 1))
		if ((n != INDEX)); then
			reset_view
			draw
		fi
		;;
	i) view_key in ;;
	o) view_key out ;;
	z) view_key toggle ;;
	0) view_key fit ;;
	w) view_key up ;;
	a) view_key left ;;
	s) view_key down ;;
	d) view_key right ;;
	q) QUIT=1 ;;
	esac
}

# NOW = the time in milliseconds: $EPOCHREALTIME in bash 5, perl under /bin/bash 3.2.
now_ms() {
	if [[ -n ${EPOCHREALTIME-} ]]; then
		NOW=${EPOCHREALTIME//[!0-9]/}
		NOW=$((10#$NOW / 1000))
		return
	fi
	NOW=$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null)
	[[ $NOW =~ ^[0-9]+$ ]] || NOW=$((SECONDS * 1000))
}

# mouse_view zoom key col row | drag dcols drows: changes the view and draws it if it moved.
mouse_view() {
	local was="$LEVEL $CX2 $CY2"
	[[ -n ${IMG_W[$INDEX]-} ]] || return
	if [[ $1 == zoom ]]; then
		zoom_at "${IMG_W[$INDEX]}" "${IMG_H[$INDEX]}" "$BOXC" "$BOXR" "$2" "$3" "$4"
	else
		drag_view "${IMG_W[$INDEX]}" "${IMG_H[$INDEX]}" "$BOXC" "$BOXR" "$2" "$3"
	fi
	[[ "$LEVEL $CX2 $CY2" != "$was" ]] && draw
	:
}

# A left press on the image starts a drag (DRAG) from cell DRAG_C,DRAG_R; DRAGGED once it moves.
# LAST_T LAST_C LAST_R remember the last press, for a double click.
DRAG=0 DRAGGED=0 DRAG_C=0 DRAG_R=0 LAST_T=0 LAST_C=0 LAST_R=0

# on_mouse button col row up: one SGR report (up is 1 for a release).
on_mouse() {
	local b=$1 col=$2 row=$3 up=$4 dc dr
	if ((b & 64)); then
		# The wheel: up (64) zooms in, down (65) out, about the pointer.
		((row <= BOXR)) || return
		if ((b & 1)); then mouse_view zoom out "$col" "$row"; else mouse_view zoom in "$col" "$row"; fi
		return
	fi
	if ((b & 32)); then
		# A move with the button down. A crop takes about 100ms, so the view follows every 2 cells.
		((DRAG)) || return
		dc=$((col - DRAG_C)) dr=$((row - DRAG_R))
		((dc != 0 || dr != 0)) && DRAGGED=1
		if ((dc * dc >= 4 || dr * dr >= 4)); then
			DRAG_C=$col DRAG_R=$row
			mouse_view drag "$dc" "$dr"
		fi
		return
	fi
	# The middle and right buttons are left alone.
	((b & 3)) && return
	if ((up)); then
		((DRAG)) || return
		DRAG=0
		dc=$((col - DRAG_C)) dr=$((row - DRAG_R))
		if ((dc != 0 || dr != 0)); then
			mouse_view drag "$dc" "$dr"
		fi
		if ((DRAGGED || dc != 0 || dr != 0)); then
			LAST_T=0
			return
		fi
		# A click on the left or right tenth of the screen steps through the images.
		edge_at "$col" "$BOXC"
		[[ $EDGE == prev ]] && on_key h
		[[ $EDGE == next ]] && on_key l
		return
	fi
	if ((row > BOXR)); then
		LAST_T=0
		button_at "$col"
		case $BTN in
		prev) on_key h ;;
		next) on_key l ;;
		out) on_key o ;;
		in) on_key i ;;
		fit) on_key 0 ;;
		quit) on_key q ;;
		esac
		return
	fi
	now_ms
	edge_at "$col" "$BOXC"
	if [[ -z $EDGE ]] && double_click "$LAST_T" "$LAST_C" "$LAST_R" "$NOW" "$col" "$row"; then
		LAST_T=0
		mouse_view zoom toggle "$col" "$row"
		return
	fi
	LAST_T=$NOW LAST_C=$col LAST_R=$row
	DRAG=1 DRAGGED=0 DRAG_C=$col DRAG_R=$row
}

# read_mouse: the rest of an SGR report, after its ESC [ <: button;col;row then M (press) or m (release).
read_mouse() {
	local seq='' ch='' re='^([0-9]+);([0-9]+);([0-9]+)$'
	while IFS= read -rsn1 -t "$SHORT" ch </dev/tty; do
		[[ $ch == M || $ch == m ]] && break
		seq=$seq$ch
		((${#seq} > 20)) && return
	done
	[[ $seq =~ $re ]] || return
	on_mouse "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "$([[ $ch == m ]] && echo 1 || echo 0)"
}

QUIT=0
while :; do
	key=''
	if IFS= read -rsn1 -t "$TICK" key </dev/tty; then
		case $key in
		$'\e')
			# A lone Escape quits; a mouse report is handled; an arrow or other sequence is read and dropped.
			rest=''
			IFS= read -rsn1 -t "$SHORT" rest </dev/tty
			[[ -z $rest ]] && break
			IFS= read -rsn1 -t "$SHORT" rest </dev/tty
			[[ $rest == '<' ]] && read_mouse
			;;
		*) on_key "$key" ;;
		esac
		((QUIT)) && break
	else
		term_size
		[[ "${TERM_COLS}x$TERM_ROWS" != "${COLS}x$ROWS" ]] && RESIZED=1
	fi
	if ((RESIZED)); then
		RESIZED=0
		draw
	fi
done

cleanup
trap - EXIT
if [[ ${HERDR_ENV-} == 1 && -n ${HERDR_PANE_ID-} ]]; then
	herdr pane close "$HERDR_PANE_ID" >/dev/null 2>&1
fi
exit 0
